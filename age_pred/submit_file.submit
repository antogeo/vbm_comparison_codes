Queue

# Job 5
arguments = $(data_dir)/ixi/features_ixi_cat_icbm_BSF.csv $(data_dir)/ixi/ixi_common_subj.csv ixi/ixi_cat_icbm_BSF
Queue

# Job 6
arguments = $(data_dir)/ixi/features_ixi_cat_data_BSF.csv $(data_dir)/ixi/ixi_common_subj.csv ixi/ixi_cat_data_BSF
Queue

# Job 7
arguments = $(data_dir)/ixi/features_ixi_ants_icbm_BSF.csv $(data_dir)/ixi/ixi_common_subj.csv ixi/ixi_ants_icbm_BSF
Queue

# Job 8
arguments = $(data_dir)/ixi/features_ixi_ants_fslvbm23_BSF.csv $(data_dir)/ixi/ixi_common_subj.csv ixi/ixi_ants_fslvbm23_BSF
Queue

# Job 9
