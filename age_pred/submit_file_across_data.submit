Queue

# Job 10
arguments = $(data_dir)/fslvbm1_3_ixi_enki.csv $(data_dir)/ixi_enki_common_subj.csv ixi_enki/ixi_enki_fslvbm1_3 --models $(models) $(test_dir)/features_camcan_fslvbm1_3_BSF.csv $(test_dir)/cc_common_subj.csv None
