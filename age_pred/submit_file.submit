# Job 6
arguments = $(data_dir)/enki/features_enki_cat_data_BSF.csv $(data_dir)/enki/enki_common_subj.csv enki/enki_cat_data_BSF
Queue

# Job 7
arguments = $(data_dir)/enki/features_enki_ants_icbm_BSF.csv $(data_dir)/enki/enki_common_subj.csv enki/enki_ants_icbm_BSF
Queue

# Job 8
arguments = $(data_dir)/enki/features_enki_ants_fslvbm23_BSF.csv $(data_dir)/enki/enki_common_subj.csv enki/enki_ants_fslvbm23_BSF
Queue

# Job 9
