arguments = $(data_dir)/cat_icbm_ixi_enki.csv $(data_dir)/ixi_enki_common_subj.csv ixi_enki/ixi_enki_cat_icbm --models $(models) $(test_dir)/features_camcan_cat_icbm_BSF.csv $(test_dir)/cc_common_subj.csv None
Queue

# Job 7
arguments = $(data_dir)/fmriprep_fsl_3_ixi_enki.csv $(data_dir)/ixi_enki_common_subj.csv ixi_enki/ixi_enki_fmriprep_fsl_3 --models $(models) $(test_dir)/features_camcan_fmriprep_fsl_3_BSF.csv $(test_dir)/cc_common_subj.csv None
